# Bind Poker — environment
#
# Copy to `.env` and fill in. The Normal server reads `.env` from its working directory at startup,
# and the real environment always wins over the file — so a deployment can set these as container
# variables and leave the file out entirely.
#
# `.env` is gitignored. This file is not: never put a real secret here.

# ---------------------------------------------------------------------------- Normal server (required)

# The Postgres the Normal edition stores everything in.
DATABASE_URL=postgres://bindpoker:change-me@localhost:5432/bindpoker

# The HMAC key session ids are derived from — at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every live session.
SESSION_SECRET=change-me-to-at-least-32-random-characters

# Comma-separated list of origins allowed to open a WebSocket, each an absolute
# `scheme://host[:port]` with no path and no trailing slash. There is no default: the Normal web
# client is served from its own origin, so the operator has to name it.
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------- Normal server (optional)

# Where to listen. PORT=0 binds an ephemeral port.
# PORT=8080
# HOST=0.0.0.0

# debug | info | warn | error
# LOG_LEVEL=info

# The IANA zone the daily check-in draws its day boundary in.
# ECONOMY_TIMEZONE=Asia/Ho_Chi_Minh

# How long a disconnected seated player is held before the table folds for them (0–3600).
# RECONNECT_WINDOW_SEC=90

# The built web bundle to serve at `/`. Unset means API-only: the server runs and logs a warning.
# PUBLIC_DIR=./public

# Send the session cookie only over HTTPS. Set false ONLY for a developer on plain http://localhost.
# COOKIE_SECURE=true

# Trust `X-Forwarded-*` for the client address. Set true only behind a proxy you control — with it
# on and nothing in front, any caller can choose the address the rate limiters key on.
# TRUST_PROXY=false

# Apply the committed migrations at boot. Set false when a separate job (`pnpm migrate`) applies
# them — which is what several replicas of the server want.
# AUTO_MIGRATE=true
