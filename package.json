{
  "name": "bind-poker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "build:normal": "pnpm --filter @bp/normal-web run build && pnpm --filter @bp/normal-server run build",
    "build:normal-web": "pnpm --filter @bp/normal-web run build",
    "e2e:normal": "pnpm --filter @bp/normal-web run e2e",
    "dev:normal-web": "pnpm --filter @bp/normal-web run dev",
    "db:generate": "pnpm --filter @bp/normal-server db:generate",
    "build:lite": "pnpm --filter @bp/lite run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
