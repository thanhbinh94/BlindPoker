node_modules/
dist/
packages/ui-kit/playground/dist
# per-developer preview config: paths and ports are local, not project state
.claude/launch.json
release/
coverage/
*.sqlite*
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
apps/lite/dist/
apps/lite/release/
playwright-report/
test-results/
*.tsbuildinfo

# Playwright artefacts: the screenshots are regenerated by every e2e run
apps/lite/e2e/screenshots/*
!apps/lite/e2e/screenshots/.gitkeep
apps/normal-web/e2e/screenshots/*
!apps/normal-web/e2e/screenshots/.gitkeep

# The Normal e2e server's bundle (apps/normal-server/scripts/e2e-server.mjs). Deliberately not `dist/`:
# it imports PGlite, which the shipped bundle is guarded against ever containing.
apps/normal-server/.e2e/

# the run file a live Lite instance writes next to its database (see apps/lite/server/src/run-file.ts)
bind-poker.run.json

# Database dumps and the cron log backup.sh writes beside itself (deploy/normal/backup.sh). These are
# complete copies of every account, password hash and ledger row, and the deployment guide has the
# operator run the script from inside a git checkout — so nothing about them may ever be committable.
deploy/normal/backups/
deploy/normal/backup.log

# What a LAN test run leaves beside deploy/normal-windows/run.ps1: the operator's own `.env` (their
# Neon password and the session-signing key), the pid stop.ps1 reads back, and the server's stdout
# and stderr logs. All four are per-machine and per-run; `.env.example` is the committed half.
deploy/normal-windows/.env
deploy/normal-windows/normal.pid
deploy/normal-windows/*.log
