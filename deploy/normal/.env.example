# Bind Poker — Normal edition deployment.
#
#     cp .env.example .env    &&    $EDITOR .env    &&    docker compose up -d
#
# Compose reads `.env` from *this* directory. Everything here is passed to the containers by
# docker-compose.yml; the server's full environment reference is in ../../docs/deployment-normal.md.
#
# `.env` is gitignored. This file is not — never put a real secret in it.

# ---------------------------------------------------------------------------- required

# The public hostname. Caddy gets a Let's Encrypt certificate for exactly this name, and the app's
# `ALLOWED_ORIGINS` is derived from it as `https://$DOMAIN`. DNS must already point here.
DOMAIN=poker.example.com

# The `postgres` superuser's password in the `db` container. Read by initdb on the *first* start
# only: changing it later requires an ALTER ROLE inside the database (deployment guide §8).
#
#   openssl rand -base64 24
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=CHANGE_ME

# The HMAC key session ids are derived from. Changing it logs everyone out; passwords are unaffected.
#
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# The placeholder below is deliberately too short: `loadConfig` requires at least 32 characters, so
# copying this file and forgetting this line stops the server with
# `SESSION_SECRET must be at least 32 characters, got 9` instead of bringing up a stack whose
# session-signing key is published in this repository.
SESSION_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------- optional

# The IANA zone the daily check-in draws its day boundary in.
ECONOMY_TIMEZONE=Asia/Ho_Chi_Minh

# debug | info | warn | error
LOG_LEVEL=info
