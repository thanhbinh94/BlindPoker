# Blind Luck Poker Normal — cấu hình cho một lần chạy thử trong mạng LAN trên Windows.
#
# Chép file này thành `.env` (cùng thư mục) rồi sửa hai dòng CHANGE_ME. File `.env` đã nằm trong
# .gitignore: nó chứa mật khẩu database và khoá ký phiên, đừng bao giờ commit.
#
#   Copy-Item .env.example .env
#   notepad .env
#
# run.ps1 nạp file này vào biến môi trường của phiên PowerShell rồi mới gọi server — không có file
# .env nào được ghi vào apps/normal-server.

# --- Bắt buộc ---------------------------------------------------------------------------------

# Chuỗi kết nối PostgreSQL. Neon (miễn phí) cho sẵn chuỗi này ở Dashboard → Connection Details →
# Connection string, chọn "Parameters only"/"psql" đều được, nhớ giữ nguyên `?sslmode=require`.
# Nếu mật khẩu có ký tự / ? # @ thì phải percent-encode, nếu không URL sẽ sai và server từ chối chạy.
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Khoá ký cookie phiên đăng nhập. Ít nhất 32 ký tự. Sinh một chuỗi ngẫu nhiên:
#   PowerShell:  [Convert]::ToBase64String((1..36 | ForEach-Object { Get-Random -Max 256 }))
#   openssl:     openssl rand -base64 48
# Đổi giá trị này là mọi người đang đăng nhập bị đăng xuất — chuyện bình thường khi test.
SESSION_SECRET=CHANGE_ME

# Những origin được phép mở API và WebSocket tới server này. Phải là dạng http://host:port,
# không có dấu / ở cuối, cách nhau bằng dấu phẩy.
# `<IP-LAN>` được run.ps1 thay bằng địa chỉ IPv4 LAN của máy này lúc khởi động — cứ để nguyên.
# Đổi PORT thì phải đổi cả cổng ở đây.
ALLOWED_ORIGINS=http://localhost:8080,http://<IP-LAN>:8080

# --- Mạng -------------------------------------------------------------------------------------

# Cổng HTTP. `.\run.ps1 -Port 9090` ghi đè tạm thời cho một lần chạy.
PORT=8080

# 0.0.0.0 = nghe trên mọi card mạng (máy khác trong LAN vào được).
# 127.0.0.1 = chỉ chính máy này.
HOST=0.0.0.0

# --- Bảo mật ----------------------------------------------------------------------------------

# false vì bản LAN chạy HTTP thuần: cookie đánh dấu Secure sẽ không bao giờ được trình duyệt gửi đi
# qua http:// và không ai đăng nhập được. Đặt true khi (và chỉ khi) có HTTPS ở phía trước.
COOKIE_SECURE=false

# Không có reverse proxy nào ở trước, nên không tin X-Forwarded-*. Server từ chối giá trị `true`:
# tin mọi hop làm X-Forwarded-For do client tự đặt và vô hiệu hoá mọi giới hạn theo IP.
TRUST_PROXY=false

# --- Ứng dụng ---------------------------------------------------------------------------------

# Thư mục giao diện web đã build. Đường dẫn tương đối tính từ apps/normal-server (nơi server chạy);
# run.ps1 chuyển thành đường dẫn tuyệt đối và in ra trước khi khởi động.
PUBLIC_DIR=../../apps/normal-web/dist

# run.ps1 tự chạy `node dist/migrate-cli.js` trước, nên server không cần chạy migration lần nữa.
AUTO_MIGRATE=false

# Múi giờ quyết định lúc nào sang "ngày mới" để nhận thưởng hằng ngày.
ECONOMY_TIMEZONE=Asia/Ho_Chi_Minh

# debug | info | warn | error
LOG_LEVEL=info
