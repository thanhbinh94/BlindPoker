# Bind Poker Lite — cấu hình tuỳ chọn / optional configuration.
#
# Đổi tên file này thành `.env` và đặt cạnh `bind-poker-lite.exe`.
# Rename this file to `.env` and keep it next to `bind-poker-lite.exe`.
# Mọi dòng đều có thể xoá — bỏ trống thì dùng giá trị mặc định ghi ở đây.
# Every line is optional; leave one out and the default shown here is used.
# Sửa xong phải khởi động lại exe / restart the exe after editing.

# Cổng HTTP. 0 = để hệ điều hành tự chọn. / HTTP port. 0 lets the OS pick one.
PORT=8080

# Địa chỉ lắng nghe. 0.0.0.0 = mở cho cả mạng LAN; 127.0.0.1 = chỉ máy này.
# Listen address. 0.0.0.0 serves the whole LAN; 127.0.0.1 only this machine.
HOST=0.0.0.0

# Đường dẫn file dữ liệu SQLite, tương đối so với vị trí exe.
# Path to the SQLite data file, relative to the exe.
SQLITE_PATH=./bind-poker.sqlite

# Mức log: debug | info | warn | error. / Log level.
LOG_LEVEL=info

# Múi giờ dùng để chốt mốc "ngày mới" cho thưởng hằng ngày (tên vùng IANA).
# IANA time zone that decides when the daily bonus rolls over.
ECONOMY_TIMEZONE=Asia/Ho_Chi_Minh

# Cửa sổ cho phép kết nối lại khi rớt mạng giữa ván (giây). Hết cửa sổ này thì
# ghế bị bỏ bài thay. 0 = không chờ.
# How long a disconnected seated player is held mid-hand, in seconds. 0 waits not at all.
RECONNECT_WINDOW_SEC=90

# Ghi lại lịch sử từng ván vào database. Bật lên thì file dữ liệu lớn nhanh hơn.
# Record a per-hand log in the database. Grows the data file faster.
LITE_HAND_LOG=false

# Danh sách origin được phép mở WebSocket, cách nhau bằng dấu phẩy.
# Bỏ trống = chính sách "same-host": chỉ chấp nhận trang đến từ đúng host ghi
# trong header Host (client không phải trình duyệt, không gửi Origin, vẫn vào
# được). Đủ dùng cho LAN. Chỉ khai danh sách khi đứng sau reverse proxy đổi
# origin công khai.
# Comma-separated origins allowed to open the WebSocket. Empty selects the
# "same-host" policy: an Origin must match the request's Host header, and a
# non-browser client that sends no Origin is still accepted. Set the list only
# behind a reverse proxy whose public origin differs from Host.
# ALLOWED_ORIGINS=http://192.168.1.10:8080,https://poker.example.com

# Thư mục chứa giao diện web. Chỉ dùng khi muốn thay giao diện đã nhúng sẵn
# trong exe bằng một bản build khác. / Directory holding the web UI; only needed
# to override the copy embedded in the exe.
# PUBLIC_DIR=./public
