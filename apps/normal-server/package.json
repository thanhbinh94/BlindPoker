{
  "name": "@bp/normal-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate-cli.js",
    "backfill:reputation": "node dist/reputation-backfill-cli.js",
    "db:generate": "drizzle-kit generate",
    "dev": "pnpm run build && node dist/main.js"
  },
  "dependencies": {
    "@bp/core": "workspace:*",
    "@bp/http-kit": "workspace:*",
    "@bp/server-kit": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.1.0",
    "pg": "8.23.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
