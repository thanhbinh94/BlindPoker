{
  "extends": "./tsconfig.json",
  // The build never emits: `scripts/build.mjs` runs this project as a *typecheck of what ships* and
  // esbuild produces the JavaScript. Keeping the two apart is what lets the bundle inline the
  // workspace packages (`@bp/core`, `@bp/server-kit`, `@bp/http-kit`), whose `exports` point at
  // TypeScript sources that `tsc` would have emitted references to rather than code.
  "compilerOptions": { "noEmit": true },
  "include": ["src"],
  // `e2e-entry.ts` joins them for the same reason: it opens a PGlite database, and nothing that ships
  // may so much as name a devDependency.
  "exclude": ["src/**/*.test.ts", "src/**/test-db.ts", "src/test-harness.ts", "src/e2e-entry.ts", "src/e2e-promote.ts"]
}
