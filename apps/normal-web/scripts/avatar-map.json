{
  "$comment": [
    "The only file in the repository that names a mesh inside the source packs. Everything downstream",
    "— the manifest, the item catalogue, the renderer — speaks in canonical node keys ('top/clothing_aodai/female')",
    "and canonical material names (skin, eyes, hair, cloth_primary, cloth_secondary, metal).",
    "",
    "Paths in `file` start with a `@alias` from `dirs` and are resolved under assets/avatar-src/extracted/.",
    "Run `node scripts/avatar-assets.mjs --list @parts/Male_Ranger_Body.gltf` (or on a directory) to print",
    "the node and material names of a source file when adding an entry.",
    "",
    "A variant is one of:",
    "  { file, node, merge?, tint?, scale?, scaleAnchor?, simplify? }  a mesh lifted out of a pack",
    "  { primitive: { anchor, parts: [...] }, tint? }       geometry generated from primitives, placed",
    "                                                        relative to a joint of that body's bind pose",
    "  { empty: true }                                       a node with no geometry (the 'no hair' item)",
    "`merge` folds sibling nodes into the same output node so one item can be several source meshes;",
    "`scale` is applied about the part's own bounding box (`scaleAnchor`: bottom | center | top) so a",
    "silhouette can be derived from the nearest mesh the free tier ships; `simplify` is the fraction of",
    "triangles to keep, for the one or two source meshes modelled far denser than the rest."
  ],

  "sources": [
    {
      "pack": "Quaternius — Universal Base Characters [Standard]",
      "archive": "Universal Base Characters[Standard].zip",
      "sha256": "fdbf1804c90dfc1ea03e992bff7da2dfd1a79318e13270a660180f9308455f40",
      "license": "CC0",
      "url": "https://quaternius.itch.io/universal-base-characters"
    },
    {
      "pack": "Quaternius — Modular Character Outfits – Fantasy [Standard]",
      "archive": "Modular Character Outfits - Fantasy[Standard].zip",
      "sha256": "c3468b18871cc8c8f05ab14df7712baf22cb9f389cbd870babf130e595187f70",
      "license": "CC0",
      "url": "https://quaternius.itch.io/modular-character-outfits-fantasy"
    }
  ],

  "dirs": {
    "base": "Universal Base Characters[Standard]/Base Characters/Godot - UE",
    "hair": "Universal Base Characters[Standard]/Hairstyles/Origin at 0/glTF (Godot)",
    "parts": "Modular Character Outfits - Fantasy[Standard]/Exports/glTF (Godot-Unreal)/Modular Parts"
  },

  "materials": {
    "default": "cloth_secondary",
    "canonical": {
      "skin": { "baseColor": "#e0b49a", "metallic": 0.0, "roughness": 0.85, "runtimeTinted": true },
      "eyes": { "baseColor": "#3a2a1e", "metallic": 0.0, "roughness": 0.25, "runtimeTinted": true },
      "hair": { "baseColor": "#2e2118", "metallic": 0.0, "roughness": 0.75, "runtimeTinted": true },
      "cloth_primary": { "baseColor": "#cfd2d6", "metallic": 0.0, "roughness": 0.9 },
      "cloth_secondary": { "baseColor": "#8d9298", "metallic": 0.0, "roughness": 0.9 },
      "metal": { "baseColor": "#c9ccd1", "metallic": 0.9, "roughness": 0.3 }
    },
    "bySourceName": {
      "MI_Superhero_Male": "skin",
      "MI_Superhero_Female": "skin",
      "MI_Regular_Male": "skin",
      "MI_Regular_Female": "skin",
      "MI_Eyes": "eyes",
      "MI_Hair_1": "hair",
      "MI_Hair_2": "hair",
      "MI_Peasant": "cloth_primary",
      "MI_Ranger": "cloth_primary"
    }
  },

  "outputs": {
    "hair": "hair.glb",
    "top": "outfits.glb",
    "bottom": "outfits.glb",
    "shoes": "outfits.glb",
    "hat": "accessories.glb",
    "accessory": "accessories.glb",
    "jewelry": "accessories.glb"
  },

  "bodies": {
    "male": {
      "file": "@base/Superhero_Male_FullBody.gltf",
      "node": "SuperHero_Male",
      "merge": [{ "node": "Eyes" }, { "node": "Eyebrows" }],
      "out": "body-male.glb"
    },
    "female": {
      "file": "@base/Superhero_Female_FullBody.gltf",
      "node": "Superhero_Female",
      "merge": [{ "node": "Eyes" }, { "node": "Eyebrows" }],
      "out": "body-female.glb"
    }
  },

